{
  "manifest_version": 3,
  "name": "Maps Lead Pro",
  "version": "4.3.2",
  "description": "Extraia leads do Google Maps como painel lateral persistente. Edição SaaS com licença vinculada ao painel.",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.google.com/maps*",
    "*://*.google.com.br/maps*",
    "*://*.google.com.ar/maps*",
    "*://*.google.cl/maps*",
    "*://*.google.com.mx/maps*",
    "*://*.google.com.co/maps*",
    "*://*.google.es/maps*",
    "https://tzrqcmkdkljxjkrekbyx.supabase.co/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Maps Lead Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
